extends includes/layout.pug

block content
  - const welcomeChars = Array.from('欢迎到访“我的过去”')
  - const introChars = Array.from('我是墨晓文，一个正在不断学习的开发者')
  - const roleChars = Array.from('希望和你成为朋友')
  - const snsList = [{ cls: 'fa-brands fa-github', name: 'GitHub', color: '#3d3d3d', link: 'https://github.com/MXWqwq' }, { cls: 'fa-brands fa-qq', name: 'QQ', color: '#0099FF', link: 'https://qm.qq.com/q/A8AhaoFYNU' }, { cls: 'fa-brands fa-bilibili', name: 'BiliBili', color: '#FB7299', link: 'https://space.bilibili.com/339823308?spm_id_from=333.1387.0.0' }, { svg: true, name: '网易云', color: '#C20C0C', link: 'https://music.163.com/#/user/home?id=1463708606' }]
  #gf-about
    section.gf-about-hero
      //- 头像：真实图片（themes/butterfly/source/img/avatar.jpg，圆形裁切）
      .gf-about-avatar
        img.gf-about-avatar-img(src=url_for('/img/avatar.jpg') alt='墨晓文的头像')
      .gf-about-text
        p.gf-ab-line.gf-ab-welcome(aria-label='welcome')
          each ch in welcomeChars
            span.gf-ab-char= ch
        p.gf-ab-line.gf-ab-intro(aria-label='intro')
          each ch in introChars
            span.gf-ab-char= ch
        p.gf-ab-line.gf-ab-role(aria-label='role')
          each ch in roleChars
            span.gf-ab-char= ch
        .gf-about-sns(aria-label='sns')
          //- TODO: 替换为你的真实 SNS 链接（href）
          each sns in snsList
            a.gf-sns-chip(href=(sns.link || '#') target="_blank" data-tip=sns.name style='--sns-color:' + sns.color)
              if sns.svg
                svg.gf-sns-svg(viewBox='0 0 24 24' width='1em' height='1em' fill='currentColor' aria-hidden='true')
                  path(d='M13.046 9.388a3.919 3.919 0 0 0-.66.19c-.809.312-1.447.991-1.666 1.775a2.269 2.269 0 0 0-.074.81c.048.546.333 1.05.764 1.35a1.483 1.483 0 0 0 2.01-.286c.406-.531.355-1.183.24-1.636-.098-.387-.22-.816-.345-1.249a64.76 64.76 0 0 1-.269-.954zm-.82 10.07c-3.984 0-7.224-3.24-7.224-7.223 0-.98.226-3.02 1.884-4.822A7.188 7.188 0 0 1 9.502 5.6a.792.792 0 1 1 .587 1.472 5.619 5.619 0 0 0-2.795 2.462 5.538 5.538 0 0 0-.707 2.7 5.645 5.645 0 0 0 5.638 5.638c1.844 0 3.627-.953 4.542-2.428 1.042-1.68.772-3.931-.627-5.238a3.299 3.299 0 0 0-1.437-.777c.172.589.334 1.18.494 1.772.284 1.12.1 2.181-.519 2.989-.39.51-.956.888-1.592 1.064a3.038 3.038 0 0 1-2.58-.44 3.45 3.45 0 0 1-1.44-2.514c-.04-.467.002-.93.128-1.376.35-1.256 1.356-2.339 2.622-2.826a5.5 5.5 0 0 1 .823-.246l-.134-.505c-.37-1.371.25-2.579 1.547-3.007.329-.109.68-.145 1.025-.105.792.09 1.476.592 1.709 1.023.258.507-.096 1.153-.706 1.153a.788.788 0 0 1-.54-.213c-.088-.08-.163-.174-.259-.247a.825.825 0 0 0-.632-.166.807.807 0 0 0-.634.551c-.056.191-.031.406.02.595.07.256.159.597.217.82 1.11.098 2.162.54 2.97 1.296 1.974 1.844 2.35 4.886.892 7.233-1.197 1.93-3.509 3.177-5.889 3.177zM0 12c0 6.627 5.373 12 12 12s12-5.373 12-12S18.627 0 12 0 0 5.373 0 12Z')
              else
                i.fa-fw(class=sns.cls)
              span= sns.name
      .gf-about-scroll
        i.fas.fa-chevron-down.fa-fw
    section.gf-about-slogan
      span 「夏の終わりは、いつも少し寂しい。まるで何か大きなものを失ったような気がする」
      span 「夏日的终结，总是带着些许寂寞。」
      span 「仿佛失去了什么重要的东西。」
      .gf-about-scroll
        i.fas.fa-chevron-down.fa-fw
    section.gf-about-intro
      != page.content
